{
  "expo": {
    "name": "Nilemy",
    "slug": "nilemy",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meyildiz.nilemy",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF5F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.meyildiz.nilemy",
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nilemy uses Face ID to unlock the app when App lock is on."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#80244E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "backgroundColor": "#FCF5F6"
        }
      ],
      "expo-localization",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "expo-iap",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Plum",
            "ios": "./assets/icons/icon-plum.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundColor": "#80244E"
            }
          },
          {
            "name": "Night",
            "ios": "./assets/icons/icon-night.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundColor": "#2A1520"
            }
          },
          {
            "name": "White",
            "ios": "./assets/icons/icon-white.png",
            "android": {
              "foregroundImage": "./assets/android-icon-foreground.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.745565714522-lsre4asflclkglu912qbp1875psrj36i"
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nilemy uses a photo only when you choose one as your profile picture. It stays on this phone.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "nilemy",
    "backgroundColor": "#FCF5F6",
    "extra": {
      "eas": {
        "projectId": "9629a55a-6b62-4e08-9681-be7df137b87b"
      }
    }
  }
}
