{
  "expo": {
    "name": "Nilemy",
    "slug": "nilemy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meyildiz.nilemy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF5F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.meyildiz.nilemy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nilemy uses Face ID to unlock the app when App lock is on."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#80244E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "backgroundColor": "#FCF5F6"
        }
      ],
      "expo-localization"
    ],
    "scheme": "nilemy",
    "backgroundColor": "#FCF5F6",
    "extra": {
      "eas": {
        "projectId": "9629a55a-6b62-4e08-9681-be7df137b87b"
      }
    }
  }
}
